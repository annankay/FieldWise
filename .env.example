
# ---- Google Earth Engine (satellite layers: SMAP, MODIS, GPM, GRACE, SRTM, Landsat, GEDI)
GEE_PROJECT=Your Project Name
# On a server, use a service account instead of `earthengine authenticate`:
# GEE_SERVICE_ACCOUNT=fieldwise@your-cloud-project-id.iam.gserviceaccount.com

# ---- NASA Earthdata login
EARTHDATA_USERNAME=Your Username
EARTHDATA_PASSWORD=Your Password

# ---- Climate record (NASA POWER daily starts 1981)
FIELDWISE_START_YEAR=1991
FIELDWISE_END_YEAR=2025

# ---- Protection
FIELDWISE_FETCH_LIMIT_PER_HOUR=6
FIELDWISE_MAX_CONCURRENT_FETCHES=2
# FIELDWISE_ALLOWED_ORIGINS=https://partner-site.org

# ---- Development only: synthetic test data. Keep 0 in production.
FIELDWISE_DEMO=0

FIELDWISE_HOST=127.0.0.1
FIELDWISE_PORT=8000
